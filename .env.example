# Copy to .env and fill in. .env is ignored by git; ./setup.sh renders wrangler.toml from wrangler.toml.template with these values.
# Cloudflare account that owns the Pages project and D1 database (wrangler whoami shows it).
CF_ACCOUNT_ID=
# Pages project and D1 database (wrangler d1 create <name> prints the id).
PAGES_PROJECT=quick-chat-program
D1_DATABASE_NAME=ai-knowledge
D1_DATABASE_ID=
# Sites allowed to call the API, comma separated.
ALLOWED_ORIGINS=https://fde-training-program.pages.dev,https://quick-chat-program.pages.dev
# Where the FDE program content lives, and the public site its answers link to.
FDE_DIR=../fde-training
KB_SITE_URL=https://fde-training-program.pages.dev/
# Optional: an LMS that hosts the topic courses, plus private topic, Q&A and test folders (":" separated).
KB_LMS_URL=
KB_EXTRA_TOPICS=
KB_EXTRA_CONTENT=
KB_EXTRA_EVAL=
